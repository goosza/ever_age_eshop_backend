# ============================================
# Backend Service
# ============================================

# Docker Registry
DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=your-username/everage-backend
IMAGE_TAG=main

# Database
DATABASE_URL=jdbc:postgresql://postgres:5432/everage_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_IP=your-server-ip
SERVER_URL=http://your-server-ip:8080
BACKEND_PORT=8080


# ============================================
# Frontend Service
# ============================================

FRONTEND_DOCKER_REGISTRY=ghcr.io
FRONTEND_IMAGE_NAME=your-username/everage-frontend
FRONTEND_IMAGE_TAG=main

# ============================================
# Monitoring & Management
# ============================================

# Grafana
GRAFANA_PASSWORD=changeme

# Stripe Payment Gateway
STRIPE_API_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Zasilkovna Shipping
ZASILKOVNA_API_URL=https://api.zasilkovna.cz/v4
ZASILKOVNA_API_KEY=your_zasilkovna_api_key
ZASILKOVNA_API_PASSWORD=your_zasilkovna_api_password
ZASILKOVNA_SENDER_ID=your_sender_id
ZASILKOVNA_SENDER_NAME=Everage Shop
ZASILKOVNA_SENDER_EMAIL=shop@everage.com
ZASILKOVNA_SENDER_PHONE=+420123456789
ZASILKOVNA_SANDBOX_ENABLED=true
ZASILKOVNA_ENABLED=false

# Cloudflare R2
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://media.your-domain.com

# Portainer
PORTAINER_PASSWORD=changeme