# ============================================
# Backend Service
# ============================================

# Docker Registry
DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=your-username/everage-backend
IMAGE_TAG=main

# Database
DATABASE_URL=jdbc:postgresql://postgres:5432/everage_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_IP=your-server-ip
SERVER_URL=http://your-server-ip:8080
BACKEND_PORT=8080

# Cloudflare R2 (optional - leave empty to disable)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# ============================================
# Frontend Service
# ============================================

FRONTEND_DOCKER_REGISTRY=ghcr.io
FRONTEND_IMAGE_NAME=your-username/everage-frontend
FRONTEND_IMAGE_TAG=main

# ============================================
# Monitoring & Management
# ============================================

# Grafana
GRAFANA_PASSWORD=changeme

# Portainer
PORTAINER_PASSWORD=changeme